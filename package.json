{
  "name": "browser-model-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test scripts/browser-ai-benchmark-cli.test.mjs scripts/browser-ai-rescore.test.mjs scripts/model-card-inventory.test.mjs scripts/export-model-capability-catalog.test.mjs && vitest run src",
    "benchmark:browser-ai": "node scripts/run-browser-ai-benchmark.mjs",
    "benchmark:browser-ai:summary": "node scripts/summarize-browser-ai-benchmark.mjs",
    "benchmark:browser-ai:rescore": "node scripts/rescore-browser-ai-benchmark.mjs",
    "test:browser-ai-cli": "node --test scripts/browser-ai-benchmark-cli.test.mjs scripts/browser-ai-rescore.test.mjs scripts/model-card-inventory.test.mjs",
    "benchmark:catalog:export": "node scripts/export-model-capability-catalog.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "latest",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.2",
    "vite": "latest",
    "vitest": "^3.2.4"
  }
}
